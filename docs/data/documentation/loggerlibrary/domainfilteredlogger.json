{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/LoggerLibrary\/documentation\/LoggerLibrary"]]},"abstract":[{"type":"text","text":"A logger that outputs messages to the console with per-domain log level configuration."}],"identifier":{"url":"doc:\/\/LoggerLibrary\/documentation\/LoggerLibrary\/DomainFilteredLogger","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/LoggerLibrary\/documentation\/LoggerLibrary\/PrintLogger-swift.struct","doc:\/\/LoggerLibrary\/documentation\/LoggerLibrary\/NoOpLogger"],"generated":true,"anchor":"Logger-Implementations","title":"Logger Implementations"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DomainFilteredLogger","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/LoggerLibrary\/documentation\/LoggerLibrary\/ArchitectureGuide"],"kind":"mentions"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This logger allows you to specify different log levels for different domains,","type":"text"},{"text":" ","type":"text"},{"text":"giving you fine-grained control over logging output. This is particularly useful","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"when debugging specific parts of your application without being overwhelmed by"},{"type":"text","text":" "},{"type":"text","text":"logs from other components."}]},{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"code":"DomainFilteredLogger","type":"codeVoice"},{"text":" extends the basic console logging functionality by allowing","type":"text"},{"text":" ","type":"text"},{"text":"you to configure individual log levels for each domain. Domains not specified in the","type":"text"},{"text":" ","type":"text"},{"text":"dictionary use the ","type":"text"},{"code":"defaultLogLevel","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"How-It-Works","text":"How It Works"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Each log message is associated with a domain (e.g., "},{"type":"codeVoice","code":".network"},{"type":"text","text":", "},{"type":"codeVoice","code":".database"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If the domain exists in "},{"type":"codeVoice","code":"domainLogLevels"},{"type":"text","text":", that level is used (overrides default)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the domain is not in the dictionary, "},{"type":"codeVoice","code":"defaultLogLevel"},{"type":"text","text":" is used"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The message is logged only if its level meets or exceeds the domain’s threshold","type":"text"}]}]}]},{"anchor":"Usage-Examples","level":2,"type":"heading","text":"Usage Examples"},{"anchor":"Example-1-Debugging-Network-Communication","level":3,"type":"heading","text":"Example 1: Debugging Network Communication"},{"syntax":"swift","type":"codeListing","code":["\/\/ Define common log domains by extending `LoggerDomain`:","public extension LoggerDomain {","    static let app: LoggerDomain = \"App\"","    static let network: LoggerDomain = \"Network\"","    static let database: LoggerDomain = \"Database\"","    static let location: LoggerDomain = \"Location\"","}","","\/\/ Focus on network domains while keeping other logs at info level","let logger = DomainFilteredLogger(","    defaultLogLevel: .info,","    domainLogLevels: [","        \/\/ Detailed network debugging","        .network: .debug,","","        \/\/ Suppress noisy domains","        .location: .disabled,","    ]",")","","\/\/ This will be logged (debug level meets .debug threshold)","logger.log(.debug, .network, \"Received HTTP response\")","","\/\/ This will be logged (info level meets .info default threshold)","logger.log(.info, .database, \"Database opened\")","","\/\/ This will NOT be logged (location is disabled)","logger.log(.error, .location, \"Failed to resolve location\")"]},{"anchor":"Example-2-Production-Configuration","level":3,"type":"heading","text":"Example 2: Production Configuration"},{"syntax":"swift","type":"codeListing","code":["\/\/ Only log warnings and errors in production","let logger = DomainFilteredLogger(","    defaultLogLevel: .warning,","    domainLogLevels: [:] \/\/ Empty dictionary = use default for all domains",")","","\/\/ This will NOT be logged (debug < warning threshold)","logger.log(.debug, .network, \"Processing request\")","","\/\/ This WILL be logged (error >= warning threshold)","logger.log(.error, .database, \"Connection failed\")"]},{"level":3,"text":"Example 3: Mixed Debug Levels","anchor":"Example-3-Mixed-Debug-Levels","type":"heading"},{"code":["\/\/ Different debug levels for different subsystems","let logger = DomainFilteredLogger(","    defaultLogLevel: .disabled, \/\/ Disable all by default","    domainLogLevels: [","        .network: .debug,      \/\/ Maximum detail for network","        .database: .info,      \/\/ Basic info for database","        .app: .error,          \/\/ Only errors for app","    ]",")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Available Log Levels","anchor":"Available-Log-Levels","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".disabled","type":"codeVoice"},{"text":" - No logging for this domain","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".verbose","type":"codeVoice"},{"type":"text","text":" - Most detailed logging"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".debug"},{"type":"text","text":" - Detailed debug messages"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".info"},{"type":"text","text":" - Informational messages"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".warning"},{"type":"text","text":" - Warnings and errors"}]}]},{"content":[{"inlineContent":[{"code":".error","type":"codeVoice"},{"type":"text","text":" - Only critical errors"}],"type":"paragraph"}]}]},{"level":2,"anchor":"Configuration-in-TCA","type":"heading","text":"Configuration in TCA"},{"syntax":"swift","code":["let store = Store(initialState: App.State()) {","    App()","} withDependencies: { dependencies in","    dependencies.logger = DomainFilteredLogger(","        defaultLogLevel: .info,","        domainLogLevels: [","            .network: .debug,","            .database: .debug,","        ]","    )","}"],"type":"codeListing"},{"anchor":"Performance-Note","type":"heading","level":2,"text":"Performance Note"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"message"},{"text":" parameter uses ","type":"text"},{"type":"codeVoice","code":"@autoclosure"},{"text":", meaning the message string is only","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"evaluated if the log will actually be output. This ensures efficient logging even"},{"text":" ","type":"text"},{"type":"text","text":"with expensive string operations."}]}],"kind":"content"}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DomainFilteredLogger"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"DomainFilteredLogger"}],"roleHeading":"Structure","externalID":"s:13LoggerLibrary014DomainFilteredA0V","role":"symbol","modules":[{"name":"LoggerLibrary"}],"title":"DomainFilteredLogger"},"relationshipsSections":[{"identifiers":["doc:\/\/LoggerLibrary\/documentation\/LoggerLibrary\/Logger","doc:\/\/LoggerLibrary\/s8SendableP","doc:\/\/Lo